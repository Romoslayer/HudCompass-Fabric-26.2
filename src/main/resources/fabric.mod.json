{
	"schemaVersion": 1,
	"id": "hudcompass",
	"name": "${mod_name}",
	"version": "${version}",
	"description": "Unofficial Fabric port of gigaherz's HudCompass, not affiliated with or endorsed by the original author. See where you go: a HUD compass overlay showing waypoints, the vanilla locator bar, and directions.",
	"icon": "logo.png",
	"license": "BSD-3-Clause",
	"authors": [
		"gigaherz"
	],
	"contributors": [
		"Romoslayer (Fabric 26.2 port)"
	],
	"contact": {
		"homepage": "https://github.com/Romoslayer/HudCompass-Fabric-26.2",
		"sources": "https://github.com/Romoslayer/HudCompass-Fabric-26.2",
		"issues": "https://github.com/Romoslayer/HudCompass-Fabric-26.2/issues"
	},

	"environment": "*",
	"entrypoints": {
		"client": [
			"dev.gigaherz.hudcompass.client.ClientHandler"
		],
		"main": [
			"dev.gigaherz.hudcompass.HudCompass"
		],
		"journeymap": [
			"dev.gigaherz.hudcompass.integrations.journeymap.HudCompassJourneymapPlugin"
		],
		"modmenu": [
			"dev.gigaherz.hudcompass.integrations.modmenu.HudCompassModMenuPlugin"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.0",
		"fabric-api": "*",
		"minecraft": "~26.2",
		"java": ">=25"
	},
	"suggests": {
		"journeymap": "*",
		"modmenu": "*",
		"cloth-config": "*"
	},

	"mixins": [
		"hudcompass.mixins.json"
	],
	"accessWidener": "hudcompass.accesswidener"
}
